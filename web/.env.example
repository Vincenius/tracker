# Kopiere diese Datei nach .env und passe sie an: cp .env.example .env
# .env wird nicht eingecheckt.

# Zugriffsschutz. Leer = offen für jeden, der den Port erreicht.
# Gesetzt = jedes Gerät einmalig mit http://<server>:3025/?token=<wert> aufrufen.
# Vorschlag zum Erzeugen: openssl rand -hex 16
TRACKER_TOKEN=

# Port, auf dem das Backend lauscht (im Container).
PORT=3025

# Pfad der Datendatei. Im Container zeigt das Volume auf /data.
# DATA_FILE=/data/tracker.json
